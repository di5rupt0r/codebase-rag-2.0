# codebase-rag-2.0 Environment Configuration Template
# Copy to .env and configure for your environment

# Embedding Provider: "gemini", "openai", "voyage", "ollama", or "none" (default: auto-detected from available API keys)
CODEBASE_RAG_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API
# OPENAI_API_KEY=your_openai_api_key_here

# Voyage AI API
# VOYAGE_API_KEY=your_voyage_api_key_here

# Ollama Local Embeddings
# OLLAMA_HOST=http://localhost:11434

# Retrieval Configuration
CODEBASE_RAG_TOP_K=10
CODEBASE_RAG_MODEL=text-embedding-004
